# Variables d'environnement nécessaires au déploiement (Vercel : Settings > Environment Variables)
# À définir pour les environnements Production, Preview et Development.
# Ce sont des clés publiables : aucune clé secrète / service_role ne doit être ajoutée ici.

# Utilisées par le navigateur (injectées au build par Vite)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
VITE_SUPABASE_PROJECT_ID=xxxxxxxxxxxx

# Utilisées côté serveur (rendu SSR)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
SUPABASE_PROJECT_ID=xxxxxxxxxxxx
